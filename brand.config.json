{
    "brand_name": "CEOTRADER",
    "brand_domain": "ceotraders.site",
    "brand_hostname": {
        "staging": "staging.ceotraders.site",
        "production": "ceotraders.site"
    },
    "domain_name": "ceotraders.site",
    "colors": {
        "primary": "#d6a72c",
        "secondary": "#c9d1df",
        "tertiary": "#25282e",
        "success": "#10b981",
        "danger": "#ef4444",
        "warning": "#d6a72c",
        "info": "#c9d1df",
        "neutral": "#8a909a",
        "black": "#08090b",
        "white": "#ffffff",
        "grey": {
            "50": "#f7f7f5",
            "100": "#e8e8e5",
            "200": "#d4d5d4",
            "300": "#c9d1df",
            "400": "#aeb4be",
            "500": "#8a909a",
            "600": "#62666e",
            "700": "#41444a",
            "800": "#25282e",
            "900": "#111216"
        }
    },
    "typography": {
        "font_family": {
            "primary": "Inter",
            "secondary": "Georgia, 'Times New Roman', Times, serif",
            "monospace": "'Courier New', Courier, monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [
            100,
            200,
            300,
            400,
            500
        ],
        "dark_variants": [
            600,
            700,
            800,
            900
        ],
        "opacity_variants": [
            10,
            20,
            30,
            40,
            50,
            60,
            70,
            80,
            90
        ]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "CEOTRADER",
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "ceotraders.site"
            },
            "staging": {
                "com": "staging.ceotraders.site"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}